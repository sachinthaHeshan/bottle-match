{
  "name": "bottle-match",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-assets": "mkdir -p public/images public/audio && cp -R images/. public/images/ && cp -R audio/. public/audio/",
    "dev": "pnpm sync-assets && vite",
    "build": "pnpm sync-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
